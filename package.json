{
  "name": "@bawdo/blinkstick",
  "version": "0.0.0",
  "description": "Drive BlinkStick Nano and Square from the browser (WebHID) and Node (node-hid).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bawdo/js-blinkstick.git"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:hardware": "BLINKSTICK_HARDWARE=1 vitest run test/hardware",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack --profile esm-only",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:types": "tsc -p test/types/node-consumer && tsc -p test/types/browser-consumer",
    "test:browser": "vite test-page"
  },
  "peerDependencies": {
    "node-hid": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "node-hid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "@types/w3c-web-hid": "^1.0.7",
    "esbuild": "^0.28.2",
    "node-hid": "^3.4.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
